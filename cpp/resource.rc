#include "src/resource.h"
#include "VersionResource.h"

IDI_APP_ICON ICON "favicon.ico"

1 VERSIONINFO
 FILEVERSION SMTCLYRICS_VERSION_MAJOR,SMTCLYRICS_VERSION_MINOR,SMTCLYRICS_VERSION_PATCH,0
 PRODUCTVERSION SMTCLYRICS_VERSION_MAJOR,SMTCLYRICS_VERSION_MINOR,SMTCLYRICS_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SMTCLyrics\0"
            VALUE "FileVersion", SMTCLYRICS_VERSION_STRING
            VALUE "InternalName", "SMTCLyrics\0"
            VALUE "OriginalFilename", "SMTCLyrics.exe\0"
            VALUE "ProductName", "SMTCLyrics\0"
            VALUE "ProductVersion", SMTCLYRICS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
