if(NOT DEFINED OUTPUT)
    message(FATAL_ERROR "OUTPUT is required")
endif()
if(NOT DEFINED RESOURCE_ID)
    message(FATAL_ERROR "RESOURCE_ID is required")
endif()
if(NOT DEFINED BRIDGE_DLL)
    message(FATAL_ERROR "BRIDGE_DLL is required")
endif()

file(TO_CMAKE_PATH "${BRIDGE_DLL}" BRIDGE_DLL_PATH)
get_filename_component(OUTPUT_DIR "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT}" "// Generated by CMake. Do not edit.\n${RESOURCE_ID} RCDATA \"${BRIDGE_DLL_PATH}\"\n")
